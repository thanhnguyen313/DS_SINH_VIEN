<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="av"
        x:Class="DS_SINH_VIEN.MainWindow"
        Title="Quản Lý Danh Sách Sinh Viên"
        Width="1100" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#EEF1F5"
        Loaded="Window_Loaded">

    <Window.Resources>

        <!-- Bảng màu -->
        <Color x:Key="PrimaryColor">#4F46E5</Color>
        <Color x:Key="PrimaryDarkColor">#3730A3</Color>
        <Color x:Key="PrimaryLightColor">#818CF8</Color>
        <Color x:Key="AccentColor">#06B6D4</Color>
        <Color x:Key="SurfaceColor">#FFFFFF</Color>
        <Color x:Key="BackgroundColor">#EEF1F5</Color>
        <Color x:Key="TextPrimaryColor">#1E293B</Color>
        <Color x:Key="TextSecondaryColor">#64748B</Color>
        <Color x:Key="BorderColor">#E2E8F0</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDarkColor}"/>
        <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLightColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

        <!-- Gradient Sidebar -->
        <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#4F46E5" Offset="0"/>
            <GradientStop Color="#7C3AED" Offset="0.5"/>
            <GradientStop Color="#6D28D9" Offset="1"/>
        </LinearGradientBrush>

        <!-- Style: Label -->
        <Style x:Key="SidebarLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#C7D2FE"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <!-- Style: TextBox -->
        <Style x:Key="SidebarInput" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="CaretBrush" Value="Black"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Style: ComboBox -->
        <Style x:Key="SidebarCombo" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Style: Nút Thêm -->
        <Style x:Key="AddButton" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Foreground" Value="#4F46E5"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EEF2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0E7FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Layout chính: Sidebar (trái) + DataGrid (phải) -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradient}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tiêu đề -->
                <StackPanel Grid.Row="0" Margin="24,28,24,0">
                    <TextBlock Text="Nhập thông tin"
                               FontSize="24" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Thêm sinh viên mới vào hệ thống"
                               FontSize="13" Foreground="#C7D2FE"
                               FontFamily="Segoe UI"/>
                    <Border Height="1" Background="#6366F1" Margin="0,20,0,20" Opacity="0.5"/>
                </StackPanel>

                <!-- Form nhập liệu -->
                <StackPanel Grid.Row="1" Margin="24,0,24,24">

                    <TextBlock Text="MÃ SỐ SINH VIÊN" Style="{StaticResource SidebarLabel}"/>
                    <TextBox x:Name="txtMSSV" Style="{StaticResource SidebarInput}"
                             ToolTip="Nhập mã số sinh viên, ví dụ: 23520001"/>

                    <TextBlock Text="HỌ VÀ TÊN" Style="{StaticResource SidebarLabel}"/>
                    <TextBox x:Name="txtHoTen" Style="{StaticResource SidebarInput}"
                             ToolTip="Nhập họ và tên đầy đủ"/>

                    <TextBlock Text="CHƯƠNG TRÌNH ĐÀO TẠO" Style="{StaticResource SidebarLabel}"/>
                    <ComboBox x:Name="cbCTDT" Style="{StaticResource SidebarCombo}"
                              DisplayMemberPath="TenCTDT"
                              SelectedValuePath="MaCTDT"
                              ToolTip="Chọn chương trình đào tạo"/>

                    <Button x:Name="btnThem" Content="Thêm Sinh Viên"
                            Style="{StaticResource AddButton}"
                            Click="btnThem_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DATAGRID -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tiêu đề -->
            <StackPanel Grid.Row="0" Margin="4,0,0,16">
                <TextBlock Text="Danh sách sinh viên"
                           FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="Segoe UI" Margin="0,0,0,4"/>
                <TextBlock Text="Quản lý và theo dõi thông tin sinh viên"
                           FontSize="13.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontFamily="Segoe UI"/>
            </StackPanel>

            <!-- Bảng dữ liệu -->
            <Border Grid.Row="1" Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                </Border.Effect>

                <DataGrid x:Name="dgSinhVien"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          AlternatingRowBackground="#F8FAFC"
                          RowBackground="White"
                          Background="Transparent"
                          BorderThickness="0"
                          FontSize="14.5"
                          FontFamily="Segoe UI"
                          SelectionMode="Single"
                          ColumnHeaderHeight="44"
                          RowHeight="42"
                          HorizontalScrollBarVisibility="Disabled">

                    <!-- Header cột -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="13.5"/>
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Padding" Value="16,0"/>
                            <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <!-- Hiệu ứng hover + chọn dòng -->
                    <DataGrid.RowStyle>
                        <Style TargetType="{x:Type DataGridRow}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E0E7FF"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <!-- Bỏ viền ô khi chọn -->
                    <DataGrid.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <!-- Định nghĩa các cột -->
                    <DataGrid.Columns>

                        <!-- Cột MSSV -->
                        <DataGridTextColumn Header="MSSV" Binding="{Binding MSSV}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#4F46E5"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Họ và Tên -->
                        <DataGridTextColumn Header="HỌ VÀ TÊN" Binding="{Binding HoTen}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Chương trình Đào tạo -->
                        <DataGridTextColumn Header="CHƯƠNG TRÌNH ĐÀO TẠO" Binding="{Binding TenCTDT}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="#64748B"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</Window>
